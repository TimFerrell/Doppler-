# Image recipe used on the Unraid host (docs: CLAUDE.md). Build from the repo root:
#   docker build -f Dockerfile.local -t dopplergeo:local .
FROM python:3.12-slim-bookworm
RUN apt-get update && apt-get install -y --no-install-recommends git ca-certificates curl \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY . /app
RUN pip install --no-cache-dir -r requirements.txt && pip install --no-cache-dir -e .
ENV PYTHONUNBUFFERED=1 MPLCONFIGDIR=/tmp/mpl HOME=/tmp
EXPOSE 8765
CMD ["dopplergeo", "serve", "--host", "0.0.0.0", "--port", "8765"]
