# systemd unit for the dopplergeo web app (installed by scripts/install_server.sh).
# Listens on the LAN: the app has no login, so keep the port firewalled to your local network.
[Unit]
Description=dopplergeo web interface
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__USER__
WorkingDirectory=__DIR__
ExecStart=__DIR__/.venv/bin/dopplergeo serve --host 0.0.0.0 --port 8765
Restart=on-failure
RestartSec=10
Nice=5

[Install]
WantedBy=multi-user.target
